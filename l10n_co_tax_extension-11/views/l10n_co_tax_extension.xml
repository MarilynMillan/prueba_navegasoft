<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="invoice_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="active">True</field>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="before">
        <div class="d-flex justify-content-end mb-2 pe-2">
          <button name="calcularimpuestos"
                  type="object"
                  string="Calcular Impuestos"
                  class="btn-secondary btn-sm"
                  style="width: auto;"
                  invisible="fiscal_position_id == False"/>
        </div>
      </xpath>
      <xpath expr="//field[@name='name']" position="after">
        <div class="alert alert-error" role="alert" style="margin-bottom:0px; background-color:#ff9e9e;" invisible="not_has_valid_dian == False">
                  La resolución de autorización de numeración de facturación está próxima a expirar o la numeración autorizada se está agotando. <br/>
                  <span style="font-weight:bold;">Por favor informe a la administración</span>
                </div>
        <field name="not_has_valid_dian" invisible="1"/>
      </xpath>
    </field>
  </record>
  <record id="view_move_line_tree_rete_toggle" model="ir.ui.view">
    <field name="name">account.move.line.tree.rete.toggle</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tax_ids']" position="after">
        <field name="nav_disable_rete_base_calc_line" optional="show"/>
        <field name="nav_manual_tax_override" column_invisible="1"/>
      </xpath>
    </field>
  </record>
  <record id="view_move_line_form_rete_toggle" model="ir.ui.view">
    <field name="name">account.move.line.form.rete.toggle</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tax_ids']" position="after">
        <field name="nav_disable_rete_base_calc_line"/>
        <field name="nav_manual_tax_override" invisible="1"/>
      </xpath>
    </field>
  </record>
  <record id="invoice_form_line_rete_toggle_force" model="ir.ui.view">
    <field name="name">account.move.form.invoice.lines.rete.toggle.force</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
        <field name="nav_disable_rete_base_calc_line" optional="show"/>
        <field name="nav_manual_tax_override" column_invisible="1"/>
      </xpath>
      <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="after">
        <field name="nav_disable_rete_base_calc_line"/>
        <field name="nav_manual_tax_override" invisible="1"/>
      </xpath>
    </field>
  </record>
  <record id="view_tax_form2" model="ir.ui.view">
    <field name="model">account.tax</field>
    <field name="inherit_id" ref="account.view_tax_form"/>
    <field name="arch" type="xml">
      <field name="type_tax_use" position="after">
        <field name="tax_in_invoice"/>
        <field name="based_tax_group"/>
        <field name="tax_group_id_header" invisible="based_tax_group == False"/>
      </field>
      <xpath expr="//page[@name='advanced_options']//group[@name='advanced_booleans']" position="inside">
        <field name="dont_impact_balance" invisible="amount_type == 'group'"/>
      </xpath>
      <xpath expr="//page[@name='advanced_options']//group[1]" position="inside">
        <field name="account_id_counterpart" invisible="dont_impact_balance == False"/>
        <field name="refund_account_id_counterpart" invisible="dont_impact_balance == False"/>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Bases" name="rete_bases">
          <field name="base_taxes" widget="one2many_list" nolabel="1">
            <list editable="bottom">
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="amount" widget="monetary"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
  <record id="account_base_tax_form_view" model="ir.ui.view">
    <field name="name">account.base.tax.form</field>
    <field name="model">account.base.tax</field>
    <field name="arch" type="xml">
      <form string="Base taxes">
        <group>
          <group>
            <field name="start_date"/>
            <field name="amount"/>
          </group>
          <group>
            <field name="end_date"/>
          </group>
        </group>
      </form>
    </field>
  </record>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="priority">9</field>
    <field name="arch" type="xml">
      <field name="taxes_id" widget="many2many_tags" position="replace">
        <field name="taxes_id" widget="many2many_tags" domain="[('tax_in_invoice','!=',True),                                                                       ('type_tax_use', '=', 'sale')]"/>
      </field>
      <field name="supplier_taxes_id" widget="many2many_tags" position="replace">
        <field name="supplier_taxes_id" widget="many2many_tags" domain="[('tax_in_invoice','!=',True),                                                                                ('type_tax_use', '=', 'purchase')]"/>
      </field>
      <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="inside">
        <group string="Retención">
          <field name="nav_rete_is_applicable"/>
        </group>
      </xpath>
    </field>
  </record>
  <record id="res_config_settings_view_form_rete_global_mode" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.rete.global.mode</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//app[@name='account']" position="inside">
        <block title="Retención Colombia">
          <setting string="Base global aplicable para retención" help="Si se activa, el umbral de retención se evalúa con la suma de líneas de producto aplicables.">
            <field name="nav_rete_use_global_applicable_base"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
  <record id="account_fiscal_position_inherit_view" model="ir.ui.view">
    <field name="model">account.fiscal.position</field>
    <field name="inherit_id" ref="account.view_account_position_form"/>
    <field name="priority">9</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page name="taxes_in_invoice" string="Taxes in invoice">
          <field name="tax_ids_invoice" widget="one2many_list" nolabel="1">
            <list editable="bottom">
              <field name="tax_id"/>
              <field name="account_journal_ids" widget="many2many_tags"/>
              <field name="amount" widget="monetary"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
  <record id="account_fiscal_position_base_tax_form" model="ir.ui.view">
    <field name="name">account.fiscal.position.base.tax.form</field>
    <field name="model">account.fiscal.position.base.tax</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <group>
            <field name="tax_id"/>
          </group>
          <group>
            <field name="amount"/>
          </group>
        </group>
      </form>
    </field>
  </record>
</odoo>
