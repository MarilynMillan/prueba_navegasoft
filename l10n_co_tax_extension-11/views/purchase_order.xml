<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="purchaseorder_line_disable_rete_base_view" model="ir.ui.view">
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="after">
        <field name="nav_disable_rete_base_calc_line" optional="show"/>
        <field name="nav_manual_tax_override" column_invisible="1"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/form//field[@name='taxes_id']" position="after">
        <field name="nav_disable_rete_base_calc_line"/>
        <field name="nav_manual_tax_override" invisible="1"/>
      </xpath>
    </field>
  </record>
</odoo>
