<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_l10n_co_dian_extended" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.l10n_co_dian.extended</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Add certification counters after the certification process toggle -->
                <xpath expr="//field[@name='l10n_co_dian_certification_process']" position="after">
                    <t invisible="not l10n_co_dian_certification_process">
                        <div class="mt16">
                            <label for="l10n_co_dian_cert_invoice_count" class="col-3 o_light_label"/>
                            <field name="l10n_co_dian_cert_invoice_count"/>
                        </div>
                        <div class="mt16">
                            <label for="l10n_co_dian_cert_credit_count" class="col-3 o_light_label"/>
                            <field name="l10n_co_dian_cert_credit_count"/>
                        </div>
                        <div class="mt16">
                            <label for="l10n_co_dian_cert_debit_count" class="col-3 o_light_label"/>
                            <field name="l10n_co_dian_cert_debit_count"/>
                        </div>
                        <div class="mt16">
                            <button name="action_l10n_co_certify_with_dian"
                                    type="object"
                                    string="Iniciar Proceso de Certificación"
                                    class="btn-primary"
                                    noSaveDialog="1"
                                    confirm="¡Advertencia! Esta acción realizará cambios irreversibles en su base de datos para garantizar la certificación con la DIAN. Por favor, asegúrese de ejecutar esto solo en una base de datos de pruebas."/>
                        </div>
                    </t>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
