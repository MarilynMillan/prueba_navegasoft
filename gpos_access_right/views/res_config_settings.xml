<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wt_pos_access_right</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
        	<xpath expr="//block[@id='pos_interface_section']" position="after">
        		<block title="PoS Restricciones" id="pos_restrict_section" invisible="is_kiosk_mode">
                    <div>
                        Estas configuraciones permiten a los empleados seleccionados restringir los botones POS y algunas acciones.
                    </div>
                    <field name="pos_module_pos_hr" invisible="1"/>
                    <setting id="pos_restrict_controll_button_setting" title="El empleado seleccionado no puede acceder a los botones de control" string="El empleado no puede acceder a los botones de control" invisible="not pos_module_pos_hr">
                    	<div class="content-group mt16">
                    		<div class="row">
			                    <label for="pos_restrict_quantity_employee_ids" string="Restringir cantidad" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_quantity_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_discount_employee_ids" string="Restringir descuento" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_discount_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_price_employee_ids" string="Restringir precio" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_price_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_remove_line_employee_ids" string="Restringir eliminar línea" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_remove_line_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_plus_minus_employee_ids" string="Restringir (+/-)" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_plus_minus_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
					<div class="row">
			                    <label for="pos_restrict_decimal_employee_ids" string="Restringir (,)" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_decimal_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
				        <div class="row">
			                    <label for="pos_restrict_numpad_employee_ids" string="Restringir teclado en pantalla" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_numpad_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
                    	</div>
                    </setting>
                    <setting id="pos_restrict_action_button_setting" title="El empleado no puede acceder a los botones de acción" string="El empleado no puede acceder a los botones de acción" invisible="not pos_module_pos_hr">
                    	<div class="content-group mt16">
			                <div class="row">
			                    <label for="pos_restrict_cancel_order_employee_ids" string="Restringir cancelar orden" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_cancel_order_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_cash_in_out_employee_ids" string="Restringir la entrada y salida de efectivo" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_cash_in_out_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
			                <div class="row">
			                    <label for="pos_restrict_refund_employee_ids" string="Restringir reembolso" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_refund_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
				        <div class="row">
			                    <label for="pos_restrict_reprintinvoice_employee_ids" string="Restringir reimpresion de facturas" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_reprintinvoice_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
					<div class="row">
			                    <label for="pos_restrict_print_employee_ids" string="Restringir impresión de ordenes" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_print_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
					<div class="row">
			                    <label for="pos_restrict_payment_employee_ids" string="Restringir pago de ordenes" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_payment_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
				        <div class="row">
			                    <label for="pos_restrict_pricelist_employee_ids" string="Restringir lista de precio" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_pricelist_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
				        <div class="row">
			                    <label for="pos_restrict_partner_employee_ids" string="Restringir a cambiar o agregar cliente" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_partner_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
					<div class="row">
			                    <label for="pos_restrict_actiondiscount_employee_ids" string="Restringir boton de descuento" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_actiondiscount_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
						<div class="row">
			                    <label for="pos_restrict_transfer_employee_ids" string="Restringir boton de Transferir/Fusionar" class="col-lg-4 o_light_label" />
			                    <field name="pos_restrict_transfer_employee_ids" widget="many2many_tags" placeholder="Seleccionar empleado(s)" domain="[('company_id', '=', company_id),('id','in',(pos_basic_employee_ids + pos_advanced_employee_ids))]" />
			                </div>
				
                    	</div>
                    </setting>
                </block>
        	</xpath>
		<xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_allow_pdf_download"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_allow_pdf_download" string="Permitir descarga de PDF"/>
                            <div class="text-muted">
                                Habilite esta opción para permitir la descarga del recibo del pedido como PDF.
                            </div>
                        </div>
                    </div>
                </xpath>
		<xpath expr="//block[@id='pos_interface_section']" position="inside">
                    <setting string="Cliente por defecto" help="Establecer cliente para pago por defecto">
                        <div class="content-group mt16">
                            <field name="pos_customer_id" colspan="6" options="{'no_open': True, 'no_create': True}"/>
                        </div>
                    </setting>
		    <setting string="Establecer factura para pago por defecto" help="Establecer factura para pago por defecto">
                        <div class="content-group mt16">
                            <field name="pos_invoice_default" colspan="6"/>
                        </div>
                    </setting>
                </xpath>

		
        </field>
    </record>
</odoo>
