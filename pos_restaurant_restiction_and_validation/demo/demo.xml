<odoo>
    <data noupdate="1">
        <record model="hr.employee" id="hr.employee_hne">
            <field name="pin">0000</field>
        </record>

        <record model="hr.employee" id="hr.employee_mit">
            <field name="pin">1111</field>
        </record> 

        <record model="pos.config" id="point_of_sale.pos_config_main">
            <field name="module_pos_restaurant">True</field>
            <field name="module_pos_hr">True</field>
            <field name="limit_categories">False</field>
            <field name="basic_employee_ids" eval="[(6, 0, [ref('hr.employee_hne')])]"/>
            <field name="advanced_employee_ids" eval="[(6, 0, [ref('hr.employee_mit')])]"/>
        </record>
    </data>
</odoo>
