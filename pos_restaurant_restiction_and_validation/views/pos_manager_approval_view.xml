<odoo>
    <record id="form_view_manager_approval" model="ir.ui.view">
        <field name="name">Manager Approval</field>
        <field name="model">manager.approval</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <h1 class="oe_title">
                        <field name="session_id" class="oe_inline" />
                    </h1>
                    <group col="4" colspan="4" style="background-color:#FFF7FC;">
                        <field name="receipt_number"
                            invisible="state == 'session_close,order_deleted'" />
                        <field name="order_number"
                            invisible="state == 'session_close,order_deleted'" />
                        <field name="manager_approved" />
                        <field name="cashier" />
                        <field name="state" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="tree_view_manager_approval" model="ir.ui.view">
        <field name="name">Manager Approval</field>
        <field name="model">manager.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" sample="1">
                <field name="session_id" />
                <field name="receipt_number" />
                <field name="order_number" />
                <field name="manager_approved" widget="many2one_avatar_user" />
                <field name="cashier" widget="many2one_avatar_user" />
                <field name="state" widget="badge" decoration-info="state == 'session_close'"
                    decoration-danger="state == 'orderline_deleted'" decoration-warning="state == 'orderline_qty_update'"/>
            </list>
        </field>
    </record>

    <record id="search_view_manager_approval" model="ir.ui.view">
        <field name="name">Manager Approval</field>
        <field name="model">manager.approval</field>
        <field name="arch" type="xml">
            <search>
                <group expand="0" string="Group By">
                    <filter string="State" name='state' context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manager_approval" model="ir.actions.act_window">
        <field name="name">Manager Approval</field>
        <field name="res_model">manager.approval</field>
        <field name="view_mode">list,form,search</field>
        <field name="view_id" eval="False"/>
        <field name="domain">[]</field>
        <field name="context">{'search_default_state': 1}</field>
    </record>


    <menuitem id="menuitem_manager_approval" parent="point_of_sale.menu_point_of_sale"
        action="action_manager_approval" name="Manager Approval" />


</odoo>
