<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_table_time_waiter_tracker.FloorScreen" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('table')]" position="inside">
            <!-- Timer ribbon -->
            <div t-if="this.pos.config.table_timer_enable and this.getTableTimer(table)"
                 class="timer-ribbon position-absolute bg-danger text-white">
                <t t-esc="this.getTableTimer(table)"/>
            </div>

            <!-- Waiter ribbon -->
            <div t-if="this.pos.config.table_waiter_name_enable and this.getTableWaiter(table)"
                 class="reserved-ribbon position-absolute bg-danger text-white">
                <t t-esc="this.getTableWaiter(table)"/>
            </div>

            <!-- Amount ribbon -->
            <div t-if="this.pos.config.table_order_amount_enable and this.getTableAmount(table) !== this.env.utils.formatCurrency(0)"
                 class="amount-ribbon position-absolute bg-success text-white">
                <t t-esc="this.getTableAmount(table)"/>
            </div>
        </xpath>
    </t>
</templates>