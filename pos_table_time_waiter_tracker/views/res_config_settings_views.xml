<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="after">
                <block title="POS Table Seated Time | Waiter Name | Order Amount">
                    <setting help="Table Time Counter">
                        <field name="pos_table_timer_enable" string="Table Time Counter"/>
                    </setting>
                    <setting help="Table Waiter Name">
                        <field name="pos_table_waiter_name_enable" string="Table Waiter Name"/>
                    </setting>
                    <setting help="Table Order Amount">
                        <field name="pos_table_order_amount_enable" string="Table Order Amount"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
