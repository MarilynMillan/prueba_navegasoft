<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="fix_invoice_custom.OrderReceipt" t-inherit="pos_custom_ticket.OrderReceipt" t-inherit-mode="extension">
        <!--
            Fix v2 - Basado en el XML real de pos_custom_ticket:
            1. INC/Retenciones: solo nombre + valor (sin "EN $base")
            2. Orden: Subtotal → INC → Retenciones → Total sin propina → Propina voluntaria → Total
            3. IMP PROP sigue oculto (filtro includes('prop'))
        -->

        <!-- ============================================================
             PASO 1: Reemplazar el loop de subtotals + tax_groups
             El original usa <t t-foreach="taxTotals.subtotals">
             con un <div t-foreach="subtotal.tax_groups"> adentro
             ============================================================ -->
        <xpath expr="//t[@t-foreach='taxTotals.subtotals']" position="replace">
            <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                <!-- SUBTOTAL (resta propina si existe) -->
                <div class="d-flex">
                    <span t-if="showTaxGroupLabels" class="me-2" style="visibility: hidden;">A</span>
                    <span class="text-nowrap mw-100" t-out="subtotal.name + ':'"/>
                    <span t-if="tipLine" t-esc="props.formatCurrency(subtotal.base_amount_currency - tipLine.amount_currency)" class="ms-auto"/>
                    <span t-else="" t-esc="props.formatCurrency(subtotal.base_amount_currency)" class="ms-auto"/>
                </div>

                <!-- INC / impuestos positivos (sin "EN $base", sin propina) -->
                <t t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id">
                    <t t-if="!tax_group.group_name.toLowerCase().includes('prop') and tax_group.tax_amount_currency >= 0">
                        <div class="d-flex">
                            <t t-if="showTaxGroupLabels">
                                <span t-if="tax_group.group_label" t-out="tax_group.group_label" class="me-2"/>
                                <span t-else="" class="me-2" style="visibility: hidden;">A</span>
                            </t>
                            <span class="text-nowrap mw-100" t-esc="tax_group.group_name + ':'"/>
                            <span t-esc="props.formatCurrency(tax_group.tax_amount_currency)" class="ms-auto"/>
                        </div>
                    </t>
                </t>

                <!-- RETENCIONES / impuestos negativos (sin "EN $base", sin propina) -->
                <t t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id + '_ret'">
                    <t t-if="!tax_group.group_name.toLowerCase().includes('prop') and tax_group.tax_amount_currency &lt; 0">
                        <div class="d-flex">
                            <t t-if="showTaxGroupLabels">
                                <span t-if="tax_group.group_label" t-out="tax_group.group_label" class="me-2"/>
                                <span t-else="" class="me-2" style="visibility: hidden;">A</span>
                            </t>
                            <span class="text-nowrap mw-100" t-esc="tax_group.group_name + ':'"/>
                            <span t-esc="props.formatCurrency(tax_group.tax_amount_currency)" class="ms-auto"/>
                        </div>
                    </t>
                </t>
            </t>
        </xpath>

        <!-- ============================================================
             PASO 2: Reemplazar el bloque de tipLine para reorganizar:
             Total sin Propina PRIMERO, luego Propina voluntaria
             ============================================================ -->
        <xpath expr="//t[@t-if='tipLine']" position="replace">
            <t t-if="tipLine">
                <div class="d-flex">
                    <span class="text-nowrap mw-100">Total sin Propina:</span>
                    <span t-esc="props.formatCurrency((taxTotals.order_sign * taxTotals.order_total) - tipLine.amount_currency)" class="ms-auto"/>
                </div>
                <div class="d-flex">
                    <span class="text-nowrap mw-100">Propina voluntaria:</span>
                    <span t-esc="tipLine.amount" class="ms-auto"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
