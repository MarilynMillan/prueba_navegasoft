<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="invoice_form_dian_line_restriction" model="ir.ui.view">
            <field name="name">account.move.form.dian_account_move_line_restriction</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_left_group']" position="after">
                    <group name="account_move_line_restriction" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'] or country_code != 'CO' or move_type in ['in_invoice', 'in_refund'] or not dian_grouping_active">
                        <field name="dian_grouping_active" invisible="1"/>
                        <field name="total_grouped_lines_by_variant" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
