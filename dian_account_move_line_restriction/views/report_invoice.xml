<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-set='lines']" position="replace">
                <t t-set="lines" t-value="invoices_grouped.get(o.id, o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True))"/>
            </xpath>
        </template>
        <template id="report_invoice_document_l10n_co_dian" inherit_id="l10n_co_dian.report_invoice_document">
            <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-set='lines']" position="replace">
                <t t-set="lines" t-value="invoices_grouped.get(o.id, o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True))"/>
            </xpath>
        </template>
    </data>
</odoo>
