<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dian_line_restriction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dian.line.restriction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="DIAN grouped lines">
                    <setting
                        id="dian_grouped_lines_scope_setting"
                        string="Scope for grouped lines"
                        help="Define whether grouping applies globally or only for specific journals."
                    >
                        <field name="dian_grouping_scope"/>
                    </setting>
                    <setting
                        id="dian_grouped_lines_journal_setting"
                        string="Journals with grouping"
                        invisible="dian_grouping_scope != 'journal'"
                        help="If the mode is by journal, grouping only applies when the invoice uses one of these journals."
                    >
                        <field name="dian_grouping_journal_ids" widget="many2many_tags"/>
                    </setting>
                    <setting
                        id="dian_grouped_lines_product_mode_setting"
                        string="Group by product"
                        help="Choose whether grouped lines are calculated by product variant or by product template."
                    >
                        <field name="dian_grouping_product_mode"/>
                    </setting>
                    <setting
                        id="dian_grouped_lines_limit_setting"
                        string="Grouped lines limit for invoices"
                        help="Maximum number of grouped product/variant lines allowed in customer invoices."
                    >
                        <field name="grouped_lines_limit"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
