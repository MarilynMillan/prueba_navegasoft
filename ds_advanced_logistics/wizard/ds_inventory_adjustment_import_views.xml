<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ds_inventory_adjustment_import_form" model="ir.ui.view">
        <field name="name">ds.inventory.adjustment.import.form</field>
        <field name="model">ds.inventory.adjustment.import</field>
        <field name="arch" type="xml">
            <form string="Importar Conteo de Inventario">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Formato del archivo:</strong> Excel (.xlsx) o CSV (.csv)
                        con dos columnas:<br/>
                        <b>Columna 1:</b> Referencia Interna del producto<br/>
                        <b>Columna 2:</b> Cantidad Contada<br/>
                        <br/>
                        La primera fila puede ser encabezado (se detecta automáticamente).
                    </div>
                    <group>
                        <field name="adjustment_id" invisible="1"/>
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import"
                            string="Importar"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_go_back"
                            string="Volver"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
