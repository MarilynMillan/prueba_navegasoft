<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menú en Operaciones -->
    <menuitem id="menu_ds_inventory_adjustment"
              name="Ajuste de Inventario Retroactivo"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_ds_inventory_adjustment"
              sequence="99"
              groups="stock.group_stock_manager"/>

    <!-- Menú en Reportes (misma acción con filtro aplicados) -->
    <record id="action_ds_inventory_adjustment_history" model="ir.actions.act_window">
        <field name="name">Historial de Ajustes Retroactivos</field>
        <field name="res_model">ds.inventory.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{'search_default_done': 1, 'create': False}</field>
    </record>

    <menuitem id="menu_ds_inventory_adjustment_history"
              name="Historial de Ajustes Retroactivos"
              parent="stock.menu_warehouse_report"
              action="action_ds_inventory_adjustment_history"
              sequence="99"
              groups="stock.group_stock_manager"/>

</odoo>
