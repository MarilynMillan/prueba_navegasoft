<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- VISTA LISTA                                                   -->
    <!-- ============================================================ -->
    <record id="ds_inventory_adjustment_list" model="ir.ui.view">
        <field name="name">ds.inventory.adjustment.list</field>
        <field name="model">ds.inventory.adjustment</field>
        <field name="arch" type="xml">
            <list string="Ajustes de Inventario Retroactivos"
                  decoration-info="state == 'draft'"
                  decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="adjustment_datetime" string="Fecha del Conteo"/>
                <field name="location_id"/>
                <field name="line_count" string="Productos"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_adjustment_value" string="Valor Neto Ajustes"
                       decoration-danger="total_adjustment_value &lt; 0"
                       decoration-success="total_adjustment_value &gt; 0"/>
                <field name="responsible_employee_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VISTA FORMULARIO                                              -->
    <!-- ============================================================ -->
    <record id="ds_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">ds.inventory.adjustment.form</field>
        <field name="model">ds.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form string="Ajuste de Inventario Retroactivo">
                <header>
                    <button name="action_calculate"
                            string="Calcular Cantidades"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or is_calculated"/>
                    <button name="action_calculate"
                            string="Recalcular"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft' or not is_calculated"/>
                    <button name="action_open_import_wizard"
                            string="Importar Conteo"
                            type="object"
                            class="btn-secondary"
                            icon="fa-upload"
                            invisible="state != 'draft' or not is_calculated"/>
                    <button name="action_open_confirm_dialog"
                            string="Aplicar Ajuste"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not is_calculated"/>
                    <button name="action_export_xlsx"
                            string="Exportar Excel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-excel-o"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange"
                                invisible="state != 'done'">
                            <field name="move_count" widget="statinfo"
                                   string="Movimientos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Parámetros del Conteo">
                            <field name="adjustment_datetime"
                                   readonly="state == 'done'"/>
                            <field name="location_id"
                                   readonly="state == 'done'"/>
                            <field name="product_filter"
                                   readonly="state == 'done'"/>
                            <field name="category_ids"
                                   widget="many2many_tags"
                                   invisible="product_filter != 'category'"
                                   readonly="state == 'done'"/>
                            <field name="filter_product_ids"
                                   widget="many2many_tags"
                                   invisible="product_filter != 'products'"
                                   readonly="state == 'done'"/>
                        </group>
                        <group string="Resultado" invisible="state != 'done'">
                            <field name="reason"/>
                            <field name="responsible_employee_ids" widget="many2many_tags"/>
                            <field name="applied_datetime"/>
                            <field name="total_inventory_value"/>
                            <field name="total_adjustment_value"/>
                        </group>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="is_calculated" invisible="1"/>
                    </group>
                    <notebook invisible="not is_calculated">
                        <page string="Productos" name="products">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_uom_id" readonly="1" string="UdM"/>
                                    <field name="theoretical_qty" readonly="1"
                                           string="Teórica a Fecha"/>
                                    <field name="counted_qty"
                                           string="Cantidad Contada"
                                           readonly="state == 'done'"/>
                                    <field name="difference_qty" readonly="1"
                                           string="Diferencia"
                                           decoration-danger="difference_qty &lt; 0"
                                           decoration-success="difference_qty &gt; 0"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="unit_cost" string="Costo Unit."
                                           column_invisible="parent.state != 'done'"/>
                                    <field name="difference_value" string="Valor Dif."
                                           column_invisible="parent.state != 'done'"
                                           decoration-danger="difference_value &lt; 0"
                                           decoration-success="difference_value &gt; 0"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FILTROS DE BÚSQUEDA                                           -->
    <!-- ============================================================ -->
    <record id="ds_inventory_adjustment_search" model="ir.ui.view">
        <field name="name">ds.inventory.adjustment.search</field>
        <field name="model">ds.inventory.adjustment</field>
        <field name="arch" type="xml">
            <search string="Buscar Ajustes">
                <field name="name"/>
                <field name="location_id"/>
                <field name="responsible_employee_ids"/>
                <filter string="Borradores" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Aplicados" name="done"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Ubicación" name="group_location"
                            context="{'group_by': 'location_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Fecha del Conteo" name="group_date"
                            context="{'group_by': 'adjustment_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCIÓN                                                        -->
    <!-- ============================================================ -->
    <record id="action_ds_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustes de Inventario Retroactivos</field>
        <field name="res_model">ds.inventory.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ds_inventory_adjustment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo Ajuste de Inventario Retroactivo
            </p>
            <p>
                Seleccione fecha, hora y ubicación para reconstruir las cantidades
                teóricas y registrar el conteo físico.
            </p>
        </field>
    </record>

</odoo>
