<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ticket.OrderReceipt">
        <t t-set="showTaxGroupLabels" t-value="doesAnyOrderlineHaveTaxLabel()"/>
        <t t-set="taxTotals" t-value="props.data.taxTotals"/>

        <div class="pos-receipt p-2 text-uppercase" style="font-size: 10px!important;font-weight:700!important;">
            <ReceiptHeader data="props.data.headerData" />
            <div class="mt-4">
                <div class="text-center">===================================</div>
                <div class="text-start">Factura Electrónica No.: <t t-if="props.dianValues" t-esc="props.dianValues.invoice_name"/></div>
                <!-- <div class="row text-nowrap text-uppercase w-100"> -->
                 <div class="d-flex justify-content-between">
                    <span>Localizador: <t t-out="order.name + ', ' +  getTableName()"/></span>
                    <span>Mesero: <t t-esc="props.data.cashier"/></span>
                 </div>
                 <div class="d-flex justify-content-between">
                    <span>Fecha: <t t-esc="orderDate"/></span>
                    <span>Hora: <t t-esc="orderTime"/></span>
                 </div>
                 <div class="d-flex justify-content-between">
                    <span>Cantidad de Personas: <t t-if="props.data.headerData.table and props.data.headerData.customer_count" t-esc="props.data.headerData.customer_count"/></span>
                    <span>Orden: <t t-if="props.data.headerData.trackingNumber and !props.data.headerData.bigTrackingNumber" t-esc="props.data.headerData.trackingNumber"/></span>
                 </div>
                <!-- </div> -->
                <div class="text-center">===================================</div>
                <div class="text-start">Cliente: <t t-if="props.data.customer and props.data.customer.name" t-esc="props.data.customer.name"/></div>
                <div class="text-start">Dirección: <t t-if="props.data.customer" t-esc="parseCustomerAddress(props.data.customer)"/></div>
                <div class="d-flex justify-content-between">
                    <div><t t-esc="props.data.customer?.country_id?.vat_label || 'VAT'"/> Cliente: <t t-if="props.data.customer and props.data.customer.vat" t-esc="props.data.customer.vat"/></div>
                    <div>Teléfono: <t t-if="props.data.customer and props.data.customer.phone" t-esc="props.data.customer.phone"/></div>
                </div>
                <div class="text-center">===================================</div>
            </div>
            <OrderBody lines="orderlines"/>
            <!-- <span t-out="tipLine?.amount_currency"/> -->
            <t t-if="!props.basic_receipt">
                <div t-if="taxTotals.subtotals and taxTotals.has_tax_groups" class="d-flex align-items-end flex-column">
                    <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                        <div class="d-flex">
                            <span t-if="showTaxGroupLabels" class="me-2" style="visibility: hidden;">A</span>
                            <span class="text-nowrap mw-100" t-out="subtotal.name + ':'"/>
                            <span t-if="tipLine" t-esc="props.formatCurrency(subtotal.base_amount_currency - tipLine.amount_currency)" class="ms-auto"/>
                            <span t-else="" t-esc="props.formatCurrency(subtotal.base_amount_currency)" class="ms-auto"/>
                        </div>

                        <div t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id" class="d-flex">
                            <t t-if="showTaxGroupLabels">
                                <span t-if="tax_group.group_label" t-out="tax_group.group_label" class="me-2"/>
                                <span t-else="" class="me-2" style="visibility: hidden;">A</span>
                            </t>
                            <!-- Este if acá es tremenda cagada por ponerle impuesto a la propina xd -->
                             <t t-if="tax_group.group_name.toLowerCase() !== 'propina'">
                                <span> 
                                    <span class="text-nowrap mw-100" t-esc="tax_group.group_name + ':'"/>
                                    <t t-if="!taxTotals.same_tax_base">
                                        en
                                        <span t-esc="props.formatCurrency(tax_group.base_amount_currency)"/>
                                    </t>
                                </span>
                                <span t-esc="props.formatCurrency(tax_group.tax_amount_currency)" class="ms-auto"/>
                             </t>
                        </div>
                    </t>

                    <t t-if="tipLine">
                        <div class="d-flex">
                            <span class="text-nowrap mw-100">Propina voluntaria:</span>
                            <span t-esc="tipLine.amount" class="ms-auto"/>
                        </div>

                        <div class="d-flex">
                            <span class="text-nowrap mw-100">Total sin Propina:</span>
                            <span t-esc="props.formatCurrency((taxTotals.order_sign * taxTotals.order_total) - tipLine.amount_currency)" class="ms-auto"/>
                        </div>
                    </t>

                    <div class="d-flex fs-3">
                        <!-- <span t-esc="tipLine.amount"/> -->
                        <span class="text-nowrap mw-100"><t t-out="props.data.label_total"/>:</span>
                        <span t-esc="props.formatCurrency(taxTotals.order_sign * taxTotals.order_total)" class="ms-auto"/>
                    </div>
                </div>

                <div class="mt-2 text-start">
                    <div>Cajero: <t t-esc="props.data.cashier"/></div>
                    <div>Estación: <t t-esc="props.data.posbox"/></div>
                </div>

                <div class="mt-2">
                    <div class="d-flex align-items-end flex-column" t-if="props.data.paymentlines?.length">
                        <div>Métodos de Pago:</div>
                        <div class="d-flex" t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                            <span class="me-2" t-esc="line.name + ':'"/>
                            <span t-esc="props.formatCurrency(line.amount)" class="ms-auto"/>
                        </div>
                    </div>

                    <div class="d-flex align-items-end flex-column" t-if="'order_change' in taxTotals">
                        <div class="d-flex">
                            <span class="me-2" t-esc="props.data.label_change"/>
                            <span t-esc="props.formatCurrency(taxTotals.order_sign * taxTotals.order_change)" class="ms-auto"/>
                        </div>
                    </div>
                    <div class="text-end" style="font-size:90%;">Observaciones:</div>
                </div>

                <t t-if="props.dianValues &amp;&amp; Object.keys(props.dianValues).length">
                    <t t-set="identifier" t-value="splitStr(props.dianValues.identifier)"/>
                    <div class="text-start mt-5">Resolución: <t t-esc="props.dianValues.resolution"/></div>
                    <div class="text-start" style="font-size: 8px;">
                        Cufe: <t t-esc="identifier[0]"/>
                        <t t-foreach="identifier.slice(1)" t-as="slice" t-key="slice_index">
                            <div><t t-esc="slice"/></div>
                        </t>
                    </div>
                    <div class="text-center">===================================</div>
                    <img t-att-src="props.dianValues.barcode_src" style="width: 50%;display: block;margin: 0 auto;"/>
                    <div class="text-center">===================================</div>
                </t>
            </t>
        </div>
    </t>

    <t t-name="pos_custom_ticket.OrderBody">
        <table class="table table-borderless mt-4">
            <thead>
                <tr class="text-start" style="margin:0;padding: 0;">
                    <th style="margin:0;padding: 0;">Cant.</th>
                    <th style="margin:0;padding: 0;">Descripción</th>
                    <th class="text-end ms-auto" style="margin:0;padding: 0;">Importe</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="props.lines" t-as="line" t-key="line_index">
                    <Orderline line="line"/>
                </t>
            </tbody>
        </table>
    </t>

    <t t-name="pos_custom_ticket.Orderline">
        <tr class="text-start text-wrap" style="margin: 0;padding: 0;">
            <td style="margin: 0;padding: 0;"><t t-esc="floatToInt(props.line.qty)"/></td>
            <td style="margin: 0;padding: 0;"><t t-esc="props.line.productName"/></td>
            <td class="text-end" style="margin: 0;padding: 0;"><t t-esc="props.line.price"/></td>
        </tr>
    </t>
</templates>