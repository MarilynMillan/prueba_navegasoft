<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_picking_form_inherit_employee" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.employee</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

             <xpath expr="//field[@name='location_id']" position="after">
                <field name="has_dotacion_product" invisible="1"/>
                <field name="employee_id" invisible="not has_dotacion_product"/>
             </xpath>
        </field>
        
    </record>
</odoo>