<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_dotacion_tree" model="ir.ui.view">
        <field name="name">hr.employee.dotacion.tree</field>
        <field name="model">hr.employee.dotacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="cost"/>
                <field name="picking_id"/>
                <field name="payroll_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_hr_employee_dotacion_form" model="ir.ui.view">
        <field name="name">hr.employee.dotacion.form</field>
        <field name="model">hr.employee.dotacion</field>
        <field name="arch" type="xml">
            <form string="Dotación Entregada">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="employee_id"/>
                        <field name="cost"/>
                        <field name="picking_id"/>
                        <field name="payroll_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_hr_employee_dotacion" model="ir.actions.act_window">
        <field name="name">Dotaciones</field>
        <field name="res_model">hr.employee.dotacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú dentro de Nómina -->
    <menuitem id="menu_hr_employee_dotacion"
              name="Dotaciones"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_hr_employee_dotacion"
              sequence="30"/>
</odoo>