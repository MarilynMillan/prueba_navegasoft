<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Global Tax in Sale Order -->
        <record model="ir.ui.view" id="sale_order_view_inherit_global_tax">
            <field name="name">oin.sale.order.view.inherit.global.tax</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="after">
                    <group class="mt-2 mt-md-0">
                        <group>
                            <field name="tax_id" widget="many2many_tags"
                                domain="[('type_tax_use','=','sale')]"
                                readonly="state not in ['draft','sent']"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Global Tax in Purchase Order -->
        <record model="ir.ui.view" id="purchase_order_view_inherit_global_tax">
            <field name="name">oin.purchase.order.view.inherit.global.tax</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="after">
                    <group class="mt-2 mt-md-0">
                        <group>
                            <field name="taxes_id" widget="many2many_tags"
                                domain="[('type_tax_use','=','purchase')]"
                                readonly="state not in ['draft','sent']"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
