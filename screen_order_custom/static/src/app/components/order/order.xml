<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="screen_order_custom.OrderHeader" t-inherit="pos_preparation_display.Order" t-inherit-mode="extension">
        <!-- Reemplazar "T20" por "MESA 20 - TERRAZA" -->
        <xpath expr="//div[hasclass('o_pdis_table')]" position="replace">
            <div class="o_pdis_table" t-if="this.props.order.table and this.props.order.table.table_number">
                <span>
                    MESA <t t-esc="this.props.order.table.table_number"/>
                    <t t-if="this.props.order.table.floor_name">
                        - <t t-esc="this.props.order.table.floor_name"/>
                    </t>
                </span>
            </div>
        </xpath>

        <!-- Quitar el #589 (tracking_number) -->
        <xpath expr="//div[hasclass('o_pdis_tracker')]" position="replace">
        </xpath>

        <!-- Reemplazar responsible por waiter_name -->
        <xpath expr="//div[hasclass('o_pdis_staff')]" position="replace">
            <div t-if="this.props.order.waiter_name" class="o_pdis_staff w-100 text-truncate flex-shrink-1">
                <i class="fa fa-user-circle-o pe-1" aria-hidden="true"/>
                <span t-esc="this.props.order.waiter_name"/>
            </div>
        </xpath>
    </t>
</templates>
