<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_fee_arl_tree" model="ir.ui.view">
        <field name="name">hr.fee.arl.tree</field>
        <field name="model">hr.fee.arl</field>
        <field name="arch" type="xml">
            <list >
                <field name="name"/>
                <field name="code"/>
                 <field name="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_hr_fee_arl_form" model="ir.ui.view">
        <field name="name">hr.fee.arl.form</field>
        <field name="model">hr.fee.arl</field>
        <field name="arch" type="xml">
            <form string="Tarifas por clase de Riesgo ARL">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_fee_arl" model="ir.actions.act_window">
        <field name="name">Conceptos egreso/ingreso</field>
        <field name="res_model">hr.fee.arl</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tarifas por clase de Riesgo ARL
             </p>
        </field>
    </record>

    <menuitem 
        id="menu_hr_fee_arl"
        name="Tarifas Riesgo ARL"
        parent="hr_payroll.menu_hr_payroll_global_settings"
        action="action_hr_fee_arl"
        sequence="60" 
    />

</odoo>