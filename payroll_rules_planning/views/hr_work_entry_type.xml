<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_hr_work_entry_type_view_form_overlap" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.payroll.overlap</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="allow_overlap"/>
                <field name="count_by_days"/>
            </xpath>
        </field>
    </record>

    <record id="payroll_hr_work_entry_type_view_tree_overlap" model="ir.ui.view">
        <field name="name">hr.work.entry.type.tree.payroll.overlap</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="allow_overlap" optional="show"/>
                <field name="count_by_days" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
