<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_company_form_hr_bonus" model="ir.ui.view">
    <field name="name">res.company.form.hr.bonus.recargos</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="priority">50</field>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Bonos y Recargos" name="page_hr_bonus_recargos">
          <group>
            <group string="Diferimiento de Pago">
              <field name="hr_bonus_defer_to_next_quincena"/>
              <label for="hr_bonus_defer_to_next_quincena"/>
            </group>

            <group name="mob_rod_group" string="Asignaciones de transporte (por dia)" col="2">
              <field name="perc_rec_noct" string="Recargo Nocturno (%)" class="o_force_label" placeholder="35.0"/>
              <field name="perc_rec_noct_fest" string="Recargo Noct. Festivo (%)" class="o_force_label" placeholder="75.0"/>
              <field name="perc_rec_diur_dom" string="Recargo Diurno Dominical (%)" class="o_force_label" placeholder="75.0"/>
              <field name="hr_night_shift_weekly_limit" string="Umbral semanal turnos sucesivos" class="o_force_label" placeholder="36.0"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
