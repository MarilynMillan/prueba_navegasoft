<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="paperformat_contract_certification" model="report.paperformat">
        <field name="name">Certificate Employee</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>
    <record id="paperformat_income" model="report.paperformat">
        <field name="name">Certificate Income</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_laboral_certification" model="ir.actions.report">
        <field name="name">Laboral Certification</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.laboral_c</field>
        <field name="report_file">employee_reports_portal.laboral_c</field>
        <field name="print_report_name">'Laboral Certification'</field>
        <field name="attachment_use">True</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_contract_certification"/>
    </record>
    <record id="action_report_laboral_certification_salary" model="ir.actions.report">
        <field name="name">Laboral Certification + Salary</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.laboral_c_salary</field>
        <field name="report_file">employee_reports_portal.laboral_c_salary</field>
        <field name="print_report_name">'Laboral Certification + Salary'</field>
        <field name="attachment_use">True</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_contract_certification"/>
    </record>
    <!-- action_report_laboral_certification_salary_variable -->
    <record id="action_report_laboral_certification_fn_salary_variable" model="ir.actions.report">
        <field name="name">Certificado laboral + Salario variable</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.laboral_c_salary_variable</field>
        <field name="report_file">employee_reports_portal.laboral_c_salary_variable</field>
        <field name="print_report_name">'Laboral Certification + Salario variable'</field>
        <field name="attachment_use">True</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_contract_certification"/>
    </record>
    <record id="action_report_laboral_certification_fn" model="ir.actions.report">
        <field name="name">Laboral Certification + Functions</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.laboral_c_fn</field>
        <field name="report_file">employee_reports_portal.laboral_c_fn</field>
        <field name="print_report_name">'Laboral Certification + Functions'</field>
        <field name="attachment_use">True</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_contract_certification"/>
    </record>
    <record id="action_report_laboral_certification_fn_salary" model="ir.actions.report">
        <field name="name">Laboral Certification + Functions +  Salary</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.laboral_c_fn_salary</field>
        <field name="report_file">employee_reports_portal.laboral_c_fn_salary</field>
        <field name="print_report_name">'Laboral Certification + Functions + Salary'</field>
        <field name="attachment_use">True</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_contract_certification"/>
    </record>
    <record id="action_report_income_withholding_certification" model="ir.actions.report">
        <field name="name">Income Withholding</field>
        <field name="model">income.withholding.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_reports_portal.iw_certification</field>
        <field name="report_file">employee_reports_portal.iw_certification</field>
        <field name="print_report_name">'Income Withholding'</field>
        <field name="attachment_use">True</field>
        <field name="paperformat_id" ref="paperformat_income"/>
    </record>
</odoo>
