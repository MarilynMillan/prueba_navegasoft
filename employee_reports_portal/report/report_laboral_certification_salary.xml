                            , con un promedio mensual por valor de <span style="text-transform:uppercase;" t-field="o.current_contract.variable_to_word"></span> 
                            <strong t-if="o.current_contract.variable != 1">pesos</strong><strong t-if="o.current_contract.variable == 1">peso</strong> 
                            <strong>moneda legal colombiana</strong> <strong>(</strong><span t-field="o.current_contract.variable"></span><strong>)</strong>.
                            correspondiente a comisiones, bonificaciones, remuneración variable y/o otros conceptos constitutivos de salario.
                        
                        
                        </div>
                        <div t-if="not o.contract_id.docente" style="text-align: justify;"> 
                        <strong style="text-transform: uppercase;" t-esc="o.name"></strong>, identificado (a) con <span t-field="o.type_document"></span> 
                            No. <strong t-esc="o.identification_id"></strong>, <span t-esc="o.text_working"></span> en nuestra empresa <span t-esc="o.company_id.name"/> <t t-if="o.company_id.vat">NIT: <span t-esc="o.company_id.vat"/></t> en el cargo de
                            <strong style="text-transform: uppercase;" t-esc="o.job_id.name"></strong> 
                        </div>

                            desde el <span t-esc="o.start_date_current_contract"></span><span t-esc="o.end_date_contract"></span>, con un contrato de tipo 
                            <strong t-esc="o.current_contract.contract_type_id.name"></strong> y una asignación salarial de <span style="text-transform:uppercase;" t-field="o.current_contract.wage_to_word">
                            </span> <strong t-if="o.current_contract.wage != 1">pesos</strong><strong t-if="o.current_contract.wage == 1">peso</strong> <strong>moneda legal colombiana</strong> <strong>
                            (</strong><span t-field="o.current_contract.wage"></span><strong>)</strong>
                            , con un promedio mensual por valor de <span style="text-transform:uppercase;" t-field="o.current_contract.variable_to_word"></span> 
                            <strong t-if="o.current_contract.variable != 1">pesos</strong><strong t-if="o.current_contract.variable == 1">peso</strong> 
                            <strong>moneda legal colombiana</strong> <strong>(</strong><span t-field="o.current_contract.variable"></span><strong>)</strong>.
                            correspondiente a comisiones, bonificaciones, remuneración variable y/o otros conceptos constitutivos de salario.
                        </div>
                        </p>
                        <br/><br/><br/>
                        <p class="text-justify">
                            Se expide a solicitud del interesado en la ciudad de <span t-esc="o.company_id.cert_city or o.company_id.partner_id.city or 'Bogotá'"/> el <t t-esc="o.date_now"/>.
                        </p>
                        <br/><br/><br/>
                        <p t-esc="o.company_id.cert_closing_text or 'Cordialmente,'"/>
                        <br/><br/>
                        <t t-call="employee_reports_portal.certificate_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
