<odoo>
    <template id="certificate_footer">
        <div style="width:100%; text-align:center;">
            <!-- Fila de logos centrados -->
            <table style="width:100%; border-collapse:collapse; margin:0 auto;">
                <tr>
                    <td style="width:50%; text-align:center; vertical-align:middle;">
                        <img t-att-src="'/company_logo/%s' % o.company_id.id" style="max-height:70px; display:inline-block;"/>
                    </td>
                    <td style="width:50%; text-align:center; vertical-align:middle;">
                        <t t-if="o.company_id.certificate_logo_2">
                            <img t-att-src="'/web/image/res.company/%s/certificate_logo_2' % o.company_id.id" style="max-height:70px; display:inline-block;"/>
                        </t>
                        <t t-else="">
                           <!--  <img src="/employee_reports_portal/static/src/img/campoalto.png" style="max-height:70px; display:inline-block;"/> -->
                        </t>
                    </td>
                </tr>
            </table>

            <!-- Información de la empresa centrada -->
            <div style="margin-top:8px; text-align:center;">
                <strong style="line-height:25px;" t-raw="o.company_id.sudo().certificate_company_info or ''"/>
            </div>
        </div>
    </template>



