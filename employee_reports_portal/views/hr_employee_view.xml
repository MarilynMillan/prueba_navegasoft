<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="hr_employee_view" model="ir.ui.view">
            <field name="name">hr.employee.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']//field[@name='user_id']" position="replace">
                    <field name="user_id" string="Related User" context="{'allow_create_employee': False, 'default_create_employee': False}"/>
                </xpath>
                <xpath expr="//field[@name='identification_id']" position="before">
                    <field name="type_document"></field>
                </xpath>
                <xpath expr="//field[@name='identification_id']" position="after">
                    <field name="firm"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="functions" string="Functions">
                        <field name="employee_functions">
                            <list editable="bottom">
                                <field name="name"></field>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//notebook//page[@name='public']//group[@name='managers']" position="before">
                    <group string="Programs">
                        <field name="program_ids" widget="many2many_tags" options="{'no_create_edit': True}" placeholder="Programs" groups="hr.group_hr_user"></field>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="hr_employee_filter" model="ir.ui.view">
            <field name="name">hr.employee.search</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category_ids']" position="after">
                    <field name="program_ids" groups="hr.group_hr_user"></field>
                </xpath>
            </field>
        </record>
        <record id="open_view_program_form" model="ir.actions.act_window">
             <field name="name">Employee Programs</field>
             <field name="res_model">hr.employee.program</field>
             <field name="view_mode">tree,form</field>
         </record>
         <record id="view_employee_program_list" model="ir.ui.view">
             <field name="name">hr.employee.program.list</field>
             <field name="model">hr.employee.program</field>
             <field name="arch" type="xml">
                 <list string="Employees Programs" editable="bottom">
                     <field name="name"/>
                 </list>
             </field>
         </record>
         <menuitem
                id="menu_view_employee_program_form"
                name="Programs"
                action="open_view_program_form"
                parent="hr.menu_config_employee"
                groups="base.group_no_one"
                sequence="15"/>
    </data>
</odoo>