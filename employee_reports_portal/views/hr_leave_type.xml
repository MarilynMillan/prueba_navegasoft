<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="hr_employee_type_view_condicion" model="ir.ui.view">
            <field name="name">hr.leave.type.view.condicion</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='employee_requests']" position="after">
                    <field name="condicion"/>
                    <field name="obligar_adjunto" />
                    <field name="tratamiento_datos" />
                </xpath>
                
            </field>
        </record>


        <record id="hr_employee_view_condicion" model="ir.ui.view">
            <field name="name">hr.leave.view.condicion</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='holiday_status_id']" position="after">
                    <field name="condicion" readonly="1"/>
                    <field name="tratamiento_datos" />
                </xpath>
            </field>
        </record>


