    <!--Template renderizado cuando el usuario de tipo portal esta logueado-->
    <template id="portal_my_home_employee" inherit_id="portal.portal_my_home" name="Mi portal de empleado">
        <xpath expr="//div[@class='o_portal_my_home']" position="before">
            <!-- Seccion de encabezado -->
            <t t-set="head">
                <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
                <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
                <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.21.1/dist/bootstrap-table.min.css" />
                <script src="https://unpkg.com/bootstrap-table@1.21.1/dist/bootstrap-table.min.js"></script>
                <script src="https://unpkg.com/bootstrap-table@1.21.0/dist/extensions/mobile/bootstrap-table-mobile.min.js"></script>
                <style type="text/css">
                    .float-right{
                        float:right!important;
                    }
                    .bootstrap-table .fixed-table-container .table thead th .th-inner{
                        white-space: normal;
                    }
                    .card{
                        position:relative;
                        display:-webkit-box;
                        display:-ms-flexbox;
                        display:flex;
                        -webkit-box-orient:vertical;
                        -webkit-box-direction:normal;
                        -ms-flex-direction:column;
                        flex-direction:column;
                        min-width:0;
                        word-wrap:break-word;
                        background-color:#fff;
                        background-clip:border-box;
                        border:1px solid rgba(0,0,0,.125);
                        border-radius:.25rem;
                    }
                    .card-body{
                        -webkit-box-flex:1;
                        -ms-flex:1 1 auto;
                        flex:1 1 auto;
                        padding:1.25rem;
                    }
                </style>
            </t>
            <!-- Seccion del cuerpo de la pagina -->
            <t t-set="my_details" t-value="True"/>
            <div class="o_portal_my_home_employee mb-4">
                <div class="oe_structure"></div>
                <h3 class="page-header">Download Your Documents and Certificates</h3>
                <div class="row">
                    <!-- Seccion de acordion de opciones de los certificados -->
                    <div id="accordion">

                        <!-- Primera sección tarjeta: Certificados laborales -->
                        <div class="card">
                            <div class="card-header" id="labor_certificate">
                                <h5 class="mb-0">
                                    <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapse_labor_certificate" aria-expanded="false" aria-controls="labor_certificate">
                                        Labor Certificates
                                    </button>
                                </h5>
                            </div>
                            <div id="collapse_labor_certificate" class="collapse" aria-labelledby="labor_certificate" data-parent="#accordion">
                                <div class="card-body">
                                    <t t-if="has_contract">
                                        <div class="row">
                                            <div class="col-sm-6 mb-2">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h4 class="card-title">Labor Certificate</h4>
                                                        <p class="card-text">Download your labor certificate without salary</p>
                                                        <a href="/certificates?type=1" target="_blank" class="btn btn-primary">Download Certification</a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-6 mb-2">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h4 class="card-title">Labor Certificate With Salary</h4>
                                                        <p class="card-text">Download your labor certificate with salary</p>
                                                        <a href="/certificates?type=2" target="_blank" class="btn btn-primary">Descargar con salario</a>
                                                        <p></p>
                                                        <a href="/certificates?type=5" target="_blank" class="btn btn-primary">Descargar salario variable</a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-6 mb-2">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h4 class="card-title">Labor Certificate With Functions</h4>
                                                        <p class="card-text">Download your labor certificate without salary with functions</p>
                                                        <a href="/certificates?type=3" target="_blank" class="btn btn-primary">Download Certification</a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-6 mb-2">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h4 class="card-title">Labor Certificate With Functions And Salary</h4>
                                                        <p class="card-text">Download your labor certificate with salary and functions</p>
                                                        <a href="/certificates?type=4" target="_blank" class="btn btn-primary">Download Certification</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-if="not has_contract">
                                        <div class="card-body">
                                            <h4 class="card-title">No active contracts found</h4>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <!-- Certificados de nómina -->
                        <t t-call="employee_reports_portal.hr_payroll" />
                        <!-- Tercera sección tarjeta: Certificado de ingress y retenciones -->
                        <div class="card">
                            <div class="card-header" id="income">
                                <h5 class="mb-0">
                                    <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapse_income" aria-expanded="false" aria-controls="income">
                                        Income Withholding Report
                                    </button>
                                </h5>
                            </div>
                            <div id="collapse_income" class="collapse" aria-labelledby="income" data-parent="#accordion">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="col-sm-8">
                                                        <h4 class="card-title">Taxable year</h4>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <form action="/certificate/income" method="post" target="_blank">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <input type="hidden" class="form-control o_website_form_input" name="payroll_id" t-att-value="certificates" required=""/>
                                                            <div class="row">
                                                                <div class="col-sm-8" style="padding-right: 0px!important; margin-top: 10px!important;">
                                                                    <select class="custom-select" id="id_year" name="year" style="width:100%;">
                                                                        <t t-foreach="years" t-as="i">
                                                                            <option t-att-value="i"><t t-esc="i"/> </option>
                                                                        </t>
                                                                    </select>
                                                                </div>
                                                                <div class="col-sm-4" style="padding-left: 0px!important;  margin-top: 4px!important;">
                                                                    <button type="submit" class="btn btn-link btn-md">Download</button>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Ausencias -->
                        <t t-call="employee_reports_portal.hr_leave" />
                    </div>
                </div>
            </div>
            <div class="col-md-12 oe_structure"/>
        </xpath>
    </template>
    <!--Template renderizado cuando no se puede renderizar un certificado laboral-->
    <template id="portal_not_found_certificate" name="Mi portal de empleado">
        <t t-call="portal.portal_layout">
            <t t-set="my_details" t-value="True"/>
            <div class="o_portal_my_home_employee">
                <div class="oe_structure"></div>
                <h3 class="page-header">Sorry, certificate not found</h3>
            </div>
            <div class="col-md-12 oe_structure"/>
        </t>
    </template>
</odoo>