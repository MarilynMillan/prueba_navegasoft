<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="hr_leave" name="My Time Off">
        <div class="card">
            <div class="card-header" id="leave">
                <h5 class="mb-0">
                    <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapse_leave" aria-expanded="false" aria-controls="leave">
                        My Time Off
                    </button>
                </h5>
            </div>

            <div id="collapse_leave" class="collapse" aria-labelledby="leave" data-parent="#accordion">
                <div class="card-body">

                    <div class="row" t-if="not leaves">
                        <div class="col-12">
                            <div class="card-body">
                                <h4 class="card-title">No Time off found</h4>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <form action="/save_leave" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="row">
                                    <div class="col-12">
                                        <div class="card-body">
                                            <strong>Registrar Ausencia</strong><br/>

                                            <strong>Tipo de ausencia:</strong>
                                            <select name="holiday_status_id" class="form-control">
                                                <option value="">select...</option>
                                                <t t-foreach="tipos or []" t-as="tipo">
                                                    <option t-att-value="tipo.id">
                                                        <t t-esc="tipo.name"/>
                                                    </option>
                                                </t>
                                            </select>

                                            <strong>Condición:</strong>
                                            <p id="condicion"></p>
                                            <br/>

                                            <label>Descripción</label>
                                            <input type="text" name="name" class="form-control"/>
                                            <br/>

                                            <label>Fecha desde</label>
                                            <input type="date" name="request_date_from" class="form-control"/>

                                            <label>Fecha hasta</label>
                                            <input type="date" name="request_date_to" class="form-control"/>

                                            <p>¿Elegir por horas?</p>
                                            <select name="request_unit_hours" class="form-control" id="mostrar_horas">
                                                <option value="NO">NO</option>
                                                <option value="SI">SI</option>
                                            </select>

                                            <div id="solo_horas">
                                                <label>Hora inicial:</label>
                                                <select name="request_hour_from" class="form-control">
                                                    <t t-foreach="range(0,25)" t-as="h">
                                                        <option t-att-value="h"><t t-esc="str(h) + ':00'" /></option>
                                                    </t>
                                                </select>

                                                <label>Hora final:</label>
                                                <select name="request_hour_to" class="form-control">
                                                    <t t-foreach="range(0,25)" t-as="h">
                                                        <option t-att-value="h"><t t-esc="str(h) + ':00'" /></option>
                                                    </t>
                                                </select>

                                                <p>Duración:</p>
                                                <input type="text" id="duration" readonly="1" class="form-control"/>
                                            </div>

                                            <label>Archivo adjunto</label>
                                            <input type="file" name="attachment" class="form-control"/>
                                            <br/>
                                            <small>Formatos permitidos: PDF, PNG, JPG, JPEG, Word, Excel. Tamaño máximo: 10 MB.</small>

                                            <div id="mostrar_tratamiento" class="mt-3">
                                                <label>Tratamiento de datos:</label>
                                                <select name="tratamiento_datos" class="form-control">
                                                    <option value="SI">SI</option>
                                                    <option value="NO">NO</option>
                                                </select>
                                                <a href="https://divitas.odoo.com/" target="_blank">
                                                    Acepto el tratamiento de datos personales de acuerdo con el aviso de privacidad.
                                                </a>
                                            </div>

                                            <br/>
                                            <button type="submit" class="btn btn-primary float-right">Enviar Ausencia</button>
                                            <p id="mensaje" style="color:red;"></p>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="row" t-if="leaves">
                        <div class="col-12">
                            <table id="hr_leave_table" class="table table-bordered"
                                   data-toggle="table"
                                   data-pagination="true"
                                   data-pagination-h-align="right"
                                   data-pagination-detail-h-align="right"
                                   data-pagination-parts="['pageList']"
                                   data-mobile-responsive="true"
                                   data-check-on-init="true">
                                <thead>
                                    <tr>
                                        <th scope="col">Time Off Type</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Start Date</th>
                                        <th scope="col">End Date</th>
                                        <th scope="col">Duración</th>
                                        <th scope="col">State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="leaves" t-as="leave">
                                        <tr>
                                            <td><span t-esc="leave.holiday_status_id.name"/></td>
                                            <td><span t-esc="leave.name"/></td>
                                            <td><span t-esc="leave.request_date_from"/></td>
                                            <td><span t-esc="leave.request_date_to"/></td>
                                            <td><span t-esc="leave.duration_display"/></td>
                                            <td>
                                                <t t-if="leave.state == 'draft'">
                                                    <span class="badge rounded-pill text-bg-info">To Submit</span>
                                                </t>
                                                <t t-if="leave.state == 'validate'">
                                                    <span class="badge rounded-pill text-bg-success">Approved</span>
                                                </t>
                                                <t t-if="leave.state == 'refuse'">
                                                    <span class="badge rounded-pill text-bg-light">Refused</span>
                                                </t>
                                                <t t-if="leave.state == 'confirm'">
                                                    <span class="badge rounded-pill text-bg-warning">To Approve</span>
                                                </t>
                                                <t t-if="leave.state == 'validate1'">
                                                    <span class="badge rounded-pill text-bg-warning">Second Approval</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div> <!-- cierre .card-body -->
            </div> <!-- cierre #collapse_leave -->
        </div> <!-- cierre .card -->
    </template>


     <template id="hr_leave_error" name="Error al Registrar Ausencia">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-danger text-center" role="alert">
                    <h3 class="mb-3">❌ No se pudo registrar la ausencia</h3>
                    <p><t t-esc="error_message" /></p>
                    <a href="/my" class="btn btn-secondary mt-3">Volver al portal</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
