<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.pos.custom.tips
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='iface_tipproduct']" position="inside">
                <div class="o_setting_box"
                     invisible="pos_iface_tipproduct ==False">
                    <div class="o_setting_right_pane">
                        <div class="text-muted mb16">
                            Agregar porcentaje de propina
                        </div>
                        <field name="pos_custom_tip_percentage" readonly="pos_has_active_session"/>
                        <div class="alert alert-warning" context="{'invisible': [('pos_has_active_session', '=', False)]}"> Nota: No puede modificar el porcentaje de propina mientras haya una sesión activa.</div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
