<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- PURCHASE ORDER FORM - requisiciones + botón carga -->
    <!-- ================================================================== -->
    <record id="purchase_order_form_inherit_ds" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.ds.purchase.advance</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button de requisiciones -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_requisitions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        invisible="ds_requisition_count == 0">
                    <field name="ds_requisition_count"
                           widget="statinfo"
                           string="Requisiciones"/>
                </button>
            </xpath>

            <!-- Sección de requisiciones antes de líneas de OC -->
            <xpath expr="//field[@name='order_line']" position="before">
                <group string="Requisiciones de Compra"
                       name="ds_requisition_section">
                    <group>
                        <field name="ds_requisition_ids"
                               widget="many2many_tags"
                               domain="[('state', 'in', ('sent', 'in_progress'))]"
                               options="{'no_create': True}"
                               placeholder="Selecciona requisiciones..."/>
                    </group>
                    <group>
                        <button name="action_load_from_requisitions"
                                string="⟶ Cargar Productos de Requisiciones"
                                type="object"
                                class="btn-primary"
                                icon="fa-download"/>
                    </group>
                </group>
            </xpath>

            <!-- Columnas de trazabilidad en líneas de OC -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_qty']"
                   position="after">
                <field name="ds_requisition_id"
                       optional="show"
                       readonly="1"
                       string="Requisición"/>
                <field name="ds_qty_requisition_original"
                       optional="hide"
                       readonly="1"/>
                <field name="ds_qty_difference"
                       optional="hide"
                       readonly="1"
                       decoration-danger="ds_qty_difference &lt; 0"
                       decoration-info="ds_qty_difference &gt; 0"/>
                <field name="ds_requisition_line_id"
                       column_invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- ================================================================== -->
    <!-- PURCHASE ORDER LIST - columna requisiciones -->
    <!-- ================================================================== -->
    <record id="purchase_order_list_inherit_ds" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.ds.purchase.advance</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ds_requisition_ids"
                       widget="many2many_tags"
                       optional="show"
                       string="Requisiciones"/>
            </xpath>
        </field>
    </record>

</odoo>
