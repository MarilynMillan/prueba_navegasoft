<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- REQUISICIÓN DE COMPRA - LIST VIEW -->
    <!-- ================================================================== -->
    <record id="ds_purchase_requisition_view_list" model="ir.ui.view">
        <field name="name">ds.purchase.requisition.view.list</field>
        <field name="model">ds.purchase.requisition</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'"
                  default_order="create_date desc">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_request"/>
                <field name="date_deadline"
                       decoration-danger="date_deadline and date_deadline &lt; current_date and state not in ('done','cancel')"/>
                <field name="line_count" string="# Productos"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'sent'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- REQUISICIÓN DE COMPRA - FORM VIEW -->
    <!-- ================================================================== -->
    <record id="ds_purchase_requisition_view_form" model="ir.ui.view">
        <field name="name">ds.purchase.requisition.view.form</field>
        <field name="model">ds.purchase.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send"
                            string="Enviar"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft"
                            string="Volver a Borrador"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count"
                                   widget="statinfo"
                                   string="Órdenes de Compra"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="user_id"
                                   widget="many2one_avatar_user"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_request"
                                   readonly="state != 'draft'"/>
                            <field name="date_deadline"
                                   readonly="state in ('done', 'cancel')"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids"
                                   readonly="state in ('done', 'cancel')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           context="{'default_purchase_ok': True}"/>
                                    <field name="product_uom_id"
                                           readonly="1"
                                           groups="uom.group_uom"/>
                                    <field name="qty_requested"/>
                                    <field name="qty_ordered"
                                           readonly="1"
                                           decoration-info="qty_ordered &gt; 0"/>
                                    <field name="qty_pending"
                                           readonly="1"
                                           decoration-danger="qty_pending &gt; 0"
                                           decoration-success="qty_pending == 0"/>
                                    <field name="line_state" widget="badge"
                                           decoration-info="line_state == 'pending'"
                                           decoration-warning="line_state == 'partial'"
                                           decoration-success="line_state == 'done'"
                                           readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes"
                                   placeholder="Notas internas, comentarios o instrucciones especiales..."
                                   readonly="state in ('done', 'cancel')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- REQUISICIÓN DE COMPRA - SEARCH VIEW -->
    <!-- ================================================================== -->
    <record id="ds_purchase_requisition_view_search" model="ir.ui.view">
        <field name="name">ds.purchase.requisition.view.search</field>
        <field name="model">ds.purchase.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_draft" string="Borrador"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Enviadas"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="filter_in_progress" string="En Proceso"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Completadas"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_available" string="Disponibles para OC"
                        domain="[('state', 'in', ('sent', 'in_progress'))]"/>
                <separator/>
                <filter name="filter_my" string="Mis Requisiciones"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_deadline_overdue" string="Vencidas"
                        domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_warehouse" string="Sede"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_user" string="Solicitante"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_deadline" string="Fecha Límite"
                            context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- REQUISICIÓN DE COMPRA - ACTION -->
    <!-- ================================================================== -->
    <record id="ds_purchase_requisition_action" model="ir.actions.act_window">
        <field name="name">Requisiciones de Compra</field>
        <field name="res_model">ds.purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ds_purchase_requisition_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera requisición de compra
            </p>
            <p>
                Las requisiciones permiten a cada sede solicitar productos
                sin necesidad de definir proveedor. Luego, el área de compras
                genera las Órdenes de Compra desde aquí.
            </p>
        </field>
    </record>

</odoo>
