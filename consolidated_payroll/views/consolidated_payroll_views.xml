<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="consolidated_payroll_tree" model="ir.ui.view">
        <field name="name">consolidated.payroll.tree</field>
        <field name="model">consolidated.payroll</field>
        <field name="arch" type="xml">
            <list string="Consolidado de nómina" duplicate="false">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="consolidated_payroll_form" model="ir.ui.view">
        <field name="name">consolidated.payroll.form</field>
        <field name="model">consolidated.payroll</field>
        <field name="arch" type="xml">
            <form string="Consolidado de nómina" duplicate="false" delete="false">
                <header>
                    <!-- states="pending" -->
                    <button string="Consolidar" name="action_done" type="object"  class="oe_highlight"/>
                    <!-- states="pending" -->
                    <button string="Eliminar" name="action_unlink" type="object"  class="oe_highlight"/>
                     <field name='count_error' invisible="1"/>
                    <button string='Corregir consolidado' name="action_rectify" type="object" class="oe_highlight" invisible='count_error == 0'/>
                    <button name='action_reconsolidate_new' string='Reconsolidar' type='object' class='oe_highlight'/>
                    <button name='action_reconsolidate_new_nocredit' string='Reagrupar en nuevo' type='object' class='oe_highlight'/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- attrs="{'invisible': [('payslip_done_count', '=', 0)]}" -->
                        <button name="action_open_payslips_done" class="oe_stat_button" icon="fa-book" type="object" help="Consolidados" invisible="payslip_done_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="payslip_done_count"/></span>
                                <span class="o_stat_text">Consolidados</span>
                            </div>
                        </button>
                        <button name="action_open_payslips" class="oe_stat_button" icon="fa-book" type="object" help="Recibos de nómina" invisible="payslip_done_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="payslip_count"/></span>
                                <span class="o_stat_text">Recibos de nómina</span>
                            </div>
                        </button>
                    </div>
                    <label for="name" string="Nombre del consolidado"/>
                    <h1>
                        <field name="name" placeholder="e.g. Abril 2022"/>
                    </h1>
                    <group>
                        <field name="rectified" />
                    </group>
                    <group colspan="4">
                        <group>
                            <field name="month" />
                        </group>
                        <group>
                            <field name="year" />
                        </group>
                         <group>
                        <field name='payment_date'/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_consolidated_payroll_tree" model="ir.actions.act_window">
        <field name="name">Consolidado de nómina</field>
        <field name="res_model">consolidated.payroll</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="consolidated_payroll_slip_tree" model="ir.ui.view">
        <field name="name">consolidated.payroll.slip.tree</field>
        <field name="model">consolidated.payroll.slip</field>
        <field name="arch" type="xml">
            <list string="Consolidados de nómina" create="false" edit="false" delete="false" duplicate="false">
                <field name="number"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="basic_wage" />
                <field name="net_wage" />
            </list>
        </field>
    </record>

    <record id="consolidated_payroll_slip_form" model="ir.ui.view">
        <field name="name">consolidated.payroll.slip.form</field>
        <field name="model">consolidated.payroll.slip</field>
        <field name="arch" type="xml">
            <form string="Consolidado de nómina">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- attrs="{'invisible': [('slip_assoc_count', '=', 0)]}" -->
                        <button name="action_open_slips_assoc" class="oe_stat_button" icon="fa-book" type="object" help="Recibos asociados" invisible="slip_assoc_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="slip_assoc_count"/></span>
                                <span class="o_stat_text">Recibos asociados</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title" name="title">
                        <h1><field name="employee_id" placeholder="Empleado"/></h1>
                        <h2><field name="number"/></h2>
                    </div>
                    <group col="4">
                        <label for="date_from" string="Periodo"/>
                        <div>
                            <field name="date_from" class="oe_inline"/> - <field name="date_to" class="oe_inline"/>
                        </div>
                        <field name="company_id" invisible="1"/>
                        <field name="contract_id" context="{'default_employee_id': employee_id}" required="1"/>
                        <field name="country_id" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                        <field name="basic_wage"/>
                        <field name="net_wage"/>
                    </group>
                    <notebook>
                        <page string="Días trabajados y entradas" name="worked_days_input" class="o_hr_payroll_worked_days_input">
                            <separator string="Días trabajados"/>
                            <field name="worked_days_line_ids">
                                <list string="Días trabajados">
                                    <field name="work_entry_type_id" />
                                    <field name="name" />
                                    <field name="number_of_days" sum="Días de trabajo totales" />
                                    <field name="number_of_hours" widget="float_time" sum="Número de horas trabajadas" />
                                    <field name="amount" sum="Importe total" />
                                </list>
                            </field>
                            <separator string="Otras entradas"/>
                            <field name="input_line_ids" colspan="4" nolabel="1">
                                <list string="Entradas">
                                    <field name="input_type_id"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cálculo del salario">
                            <field name="line_ids">
                                <list>
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="category_id" />
                                    <field name="quantity" />
                                    <field name="rate" />
                                    <field name="salary_rule_id" />
                                    <field name="amount" />
                                    <field name="total" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    </data>
</odoo>
