<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_consolidated_payroll" model="ir.sequence">
            <field name="name">Consolidado de nómina</field>
            <field name="code">consolidated.payroll.slip</field>
            <field name="prefix">CSLIP/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="action_recalculate_consolidated_slips" model="ir.actions.server">
            <field name="name">Recalcular seleccionados</field>
            <field name="model_id" ref="model_consolidated_payroll_slip"/>
            <field name="binding_model_id" ref="model_consolidated_payroll_slip"/>
            <!-- Mostrar en la vista de lista (list) -->
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                action = records.action_recalculate()
            </field>
        </record>

        <record id="ir_actions_server_consolidate_into_new_document" model="ir.actions.server">
            <field name="name">Consolidar en nuevo documento</field>
            <field name="model_id" ref="model_consolidated_payroll_slip"/>
            <field name="binding_model_id" ref="model_consolidated_payroll_slip"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = env['consolidated.payroll.slip'].browse(env.context.get('active_ids', [])).action_consolidate_into_new_document()
            </field>
        </record>

    </data>
</odoo>
