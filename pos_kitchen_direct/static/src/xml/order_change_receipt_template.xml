<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="OrderChangeReceipt" t-inherit="point_of_sale.OrderChangeReceipt" t-inherit-mode="extension" owl="1">

        <!-- Cabecera -->
        <xpath expr="//div[contains(@class, 'receipt-header') and contains(@class, 'text-center')]" position="replace">
            <div class="receipt-header text-center" style="font-size: 7px; line-height: 1;">
                <div class="pos-receipt-title" style="font-weight: bold; font-size: 8px;">
                    == CUENTA NUEVA ==
                </div>
                <div>
                    <t t-esc="changes.config_name"/><br/>
                    <t t-esc="changes.floor_name"/> - <t t-esc="changes.name"/>
                </div>
                <div>
                    <t t-esc="changes.date_print"/> 
                    <t t-esc="changes.time.hours"/>:<t t-esc="changes.time.minutes"/>
                    <t t-esc="changes.time.hours >= 12 ? 'PM' : 'AM'"/>
                </div>
                <div>
                    MESA: <t t-esc="changes.table_number"/> - PERSONAS: <t t-esc="changes.table_seats"/> 
                </div>
                <div>
                    MESERO: <t t-esc="changes.employee_name"/>
                </div>
                <t t-if="changes.customer_name">
                    <div><t t-esc="changes.customer_name"/></div>
                </t>
            </div>
        </xpath>

        <!-- Cuerpo -->
        <xpath expr="//div[contains(@class, 'pos-receipt-body')]" position="replace">
            <div class="pos-receipt-body pb-1" style="font-size: 7px; line-height: 1; text-align: left;">

                <!-- Título operativo -->
                <t t-if="operational_title">
                    <div class="pos-receipt-title text-center fw-bold" style="font-size: 7px;">
                        <t t-esc="operational_title"/>
                    </div>
                </t>

                <!-- Líneas de pedido -->
                <div t-foreach="changedlines" t-as="line" t-key="change_index" style="margin-bottom: 1px;">
                    <div t-attf-class="orderline #{line.isCombo ? 'mx-1 px-1' : 'mx-1'}">

                        <!-- Línea cancelada -->
                        <div t-if="line.qty === 0 or line.quantity === 0" class="text-uppercase fw-bold text-danger mb-1" style="font-size: 6px;">
                            <!-- CANCELADO -->
                        </div>

                        <!-- Producto -->
                        <div class="d-flex flex-wrap">
                            <span class="me-1 fw-bold"  style="min-width: 12px;">
                                <t t-esc="line.quantity || line.qty"/> x
                            </span>
                            <span class="product-name text-uppercase" style="max-width: 90%;"
                                  t-esc="line.display_name || line.name"/>
                        </div>

                        <!-- Hijos combo -->
                        <div t-if="line.type === 'parent' and line.children.length" class="ms-1 mt-1" style="font-size: 6px;">
                            <t t-foreach="line.children" t-as="child" t-key="child.name">
                                ** <t t-esc="child.name"/><br/>
                            </t>
                        </div>

                        <!-- Atributos -->
                        <div t-if="line.attribute_value_ids?.length" class="mx-1 mt-1" style="font-size: 6px;">
                            <t t-foreach="line.attribute_value_ids" t-as="attribute" t-key="attribute.id">
                                <div>- <t t-esc="attribute.name"/></div>
                            </t>
                        </div>

                        <!-- Nota -->
                        <div t-if="line.note" class="fst-italic mx-1 mt-1" style="font-size: 6px;">
                            <t t-esc="line.note.split('\n').join(', ')"/>
                        </div>
                    </div>
                </div>

                <!-- Nota general -->
                <t t-if="(!changedlines.length or fullReceipt) and changes.order_note.length">
                    <div class="mt-1 fst-italic text-center" style="font-size: 6px;">
                        <t t-esc="changes.order_note.split('\n').join(', ')"/>
                    </div>
                </t>

            </div>

            <!-- Pie de ticket -->
            <div class="text-center mt-1" style="font-size: 7px; border-top: 1px dashed #000; padding-top: 2px;">
                Gracias por su preferencia
            </div>
        </xpath>

    </t>
</templates>
