<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_notprintable_taxes" inherit_id="l10n_co_dian.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']//t[@t-set='taxes']" position="replace">
            <t t-set="taxes" t-value="line._l10n_co_line_taxes_print()"/>
        </xpath>
    </template>

    <template id="report_vendor_document_notprintable_taxes" inherit_id="l10n_co_dian.report_vendor_document">
        <xpath expr="//table[@name='invoice_line_table']//t[@t-set='taxes']" position="replace">
            <t t-set="taxes" t-value="line._l10n_co_line_taxes_print()"/>
        </xpath>
    </template>
</odoo>
