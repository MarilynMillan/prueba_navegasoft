<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_stock_valution_report_form" model="ir.ui.view">
        <field name="name">inventory.stock.valution.report.wizard.form</field>
        <field name="model">inventory.stock.valution.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory And Stock Valuation Report">
                <group invisible="file">
                    <group>
                        <field name="company_id" required="1" />
                        <field name="filter_type"  widget="radio" options="{'horizontal': true}" required="1"/>
                        <field name="product_ids" widget="many2many_tags" string="Product" invisible="filter_type != 'product'"
                            required = "filter_type == 'product'"/>
                        <field name="product_categ_ids" widget="many2many_tags" string="Category" invisible="filter_type != 'category'" required="filter_type == 'category'"/>
                    </group>
                    <group>
                        <field name="date_from" string="From Date" required="1"/>
                        <field name="date_to" string="To Date" required="1"/>
                    </group>
                </group>
                <group invisible="file">
                    <field name="report_type"  widget="radio" options="{'horizontal': true}"/>
                    <field name="warehouse_ids" widget="many2many_tags" string="Warehouse" invisible="report_type != 'warehouse'" required="report_type == 'warehouse'"/>
                    <field name="location_ids" widget="many2many_tags" string="Location" invisible="report_type != 'location'" required = "report_type == 'location'"/>
                </group>
                <field name="file" invisible="1"/>
                <separator string="Report Generated" colspan="4" invisible="not file"/>
                <p invisible="not file">
                    Here is the Excel Report: 
                    <field name="document" filename="file" invisible="not file" readonly="1"/>
                </p>
                <footer>
                    <button name="print_pdf_report" string="Print PDF" type="object" icon="fa-print" class="btn-primary" invisible="file"/>
                    <t invisible="file">OR</t>
                    <button name="print_excel_report" string="Print Excel" type="object" icon="fa-print" class="btn-primary" invisible="file"/>
                    <t invisible="file">OR</t>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_stock_valution_report" model="ir.actions.act_window">
        <field name="name">Inventory And Stock Valuation Report</field>
        <field name="res_model">inventory.stock.valution.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="wizard_inventory_stock_valution_report" 
        name="Inventory And Stock Valuation Report" 
        parent="menu_inventory_stock_movement"
        action="action_inventory_stock_valution_report"
        sequence='132' />


</odoo>