<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kardex_report_wizard_form" model="ir.ui.view">
        <field name="name">kardex.report.wizard.form</field>
        <field name="model">kardex.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Kardex - Reporte de Existencias">
                <!-- Formulario de filtros (oculto cuando ya se generó) -->
                <group invisible="document">
                    <group string="Período">
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                        <field name="company_id" required="1" groups="base.group_multi_company"/>
                    </group>
                    <group string="Ubicación">
                        <field name="filter_by" widget="radio" options="{'horizontal': true}"/>
                        <field name="warehouse_ids" widget="many2many_tags"
                               invisible="filter_by != 'warehouse'"
                               required="filter_by == 'warehouse'"/>
                        <field name="location_ids" widget="many2many_tags"
                               invisible="filter_by != 'location'"
                               required="filter_by == 'location'"/>
                    </group>
                </group>
                <group invisible="document">
                    <group string="Filtro de Productos">
                        <field name="filter_product" widget="radio"/>
                        <field name="product_ids" widget="many2many_tags"
                               invisible="filter_product != 'product'"/>
                        <field name="product_categ_ids" widget="many2many_tags"
                               invisible="filter_product != 'category'"/>
                    </group>
                    <group string="Tipo de Reporte">
                        <field name="report_mode" widget="radio"/>
                    </group>
                </group>

                <!-- Resultado: descarga -->
                <separator string="Reporte Generado" colspan="4" invisible="not document"/>
                <group invisible="not document">
                    <field name="file_name" invisible="1"/>
                    <div class="alert alert-success text-center" role="alert">
                        <strong>Kardex generado exitosamente.</strong>
                        <br/>
                        Descargue el archivo Excel:
                        <br/><br/>
                        <field name="document" filename="file_name" readonly="1"/>
                    </div>
                </group>

                <footer>
                    <button name="print_excel_report"
                            string="Generar Kardex Excel"
                            type="object"
                            icon="fa-file-excel-o"
                            class="btn-primary"
                            invisible="document"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kardex_report_wizard" model="ir.actions.act_window">
        <field name="name">Kardex de Inventario</field>
        <field name="res_model">kardex.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú bajo Inventario > Reportes -->
    <menuitem id="menu_kardex_report"
              name="Kardex de Inventario"
              parent="stock.menu_warehouse_report"
              action="action_kardex_report_wizard"
              sequence="200"
              groups="stock.group_stock_user"/>

</odoo>
