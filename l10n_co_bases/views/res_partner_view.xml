    <record id="view_partner_property_form_type_vat_mod2" model="ir.ui.view">
      <field name="name">res.partner.property.form.inherit.modifica</field>
      <field name="model">res.partner</field>
      <field name="priority">200</field>
      <field name="inherit_id" ref="l10n_latam_base.view_partner_latam_form"/>
      <field name="arch" type="xml">
        <field name="l10n_latam_identification_type_id" position="attributes">
        <attribute name="invisible">0</attribute>
      </field>  
      </field>
    </record>
    
    
    <record id="view_partner_property_form_co" model="ir.ui.view">
      <field name="name">res.partner.property.form.inherit.co</field>
      <field name="model">res.partner</field>
      <field name="priority">20</field>
      <field name="inherit_id" ref="account.view_partner_property_form"/>
      <field name="arch" type="xml">
    
        
        <field name="name" position="after">
          <!-- attrs="{'invisible': [('is_company', '=', True)]}" -->
          <h3 invisible="is_company == True">
            <!-- attrs="{'required': [('is_company', '=', False)]}" -->
            <field name="first_name" placeholder="Primer Nombre" style="width: 49%" class="oe_edit_only" required="is_company == False"/>
            <field name="middle_name" placeholder="Segundo Nombre" style="width: 49%" class="oe_edit_only"/>
            <!-- attrs="{'required': [('is_company', '=', False)]}" -->
            <field name="last_name" placeholder="Primer Apellido" style="width: 49%" class="oe_edit_only" required="is_company == False"/>
            <field name="second_last_name" placeholder="Segundo Apellido" style="width: 49%" class="oe_edit_only"/>
          </h3>
        </field>

          
        <xpath expr="//div[hasclass('o_address_format')]" position="replace">
          
                <span class="o_form_label o_td_label" name="address_name">
                  <!-- attrs="{'invisible': [('is_company', '=', True)]}"            -->
                    <b invisible="is_company == True">Address</b>
                </span>
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="street" placeholder="Street..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="type == 'contact' and parent_id != False"/>
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="city" placeholder="City" class="o_address_city" readonly="type == 'contact' and parent_id != False"/>
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="state_id" class="o_address_state" placeholder="State" readonly="type == 'contact' and parent_id != False" options="{'no_open': True, 'no_quick_create': True}"  context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id != False" />
                <!-- attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" -->
                <field name="country_id" placeholder="Country" class="o_address_country" readonly="type == 'contact' and parent_id != False" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" />
                
                 <field name="ciiu_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" placeholder="Codigo CIIU"/>
                <!-- attrs="{'required':[('parent_id','=',False)], 'invisible': [('parent_id','!=', False)]}" -->
                <!-- <field name="vat_type" placeholder="Tipo de Documento" /> -->
                <!-- attrs="{'required':[('vat_type', 'not in', ['43','R-00-PN']),('parent_id','=',False)], 'invisible': [('parent_id','!=', False)]}" -->
              <!-- <field name="vat" /> - -->
              <!-- attrs="{'required': [('vat_type', '=', '31'),('parent_id','=',False)], 'invisible': [('parent_id','!=', False)]}" -->
              <field name="vat_vd" />
             
           
            
        </xpath>
  
        <field name="city" position="attributes">
          <attribute name="invisible">True</attribute>
        </field>

        <group name="accounting_entries" position="after">
          <group string="Taxes" name="accounting_partner_taxes" groups="account.group_account_user">
            <field name="taxes_ids" widget="many2many_tags"/>
            <field name="supplier_taxes_ids" widget="many2many_tags"/>
          </group>
        </group>
        </field>
    </record>
