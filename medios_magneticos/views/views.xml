<odoo>
  <data>
  
  <record id="view_tree_categoria" model="ir.ui.view"> 
    <field name="name">Reporte Categorías</field> 
    <field name="model">account.categoria</field> 
    <field name="arch" type="xml"> 
      <!--<list colors="decoration-muted:is_done==True"> -->
      <list >
        <field name="name" />
        <field name="formato" />
        <field name="year" />
       <!-- <field name="is_done"/> -->
      </list> 
  </field> 
</record>


<record id="view_filter_categoria" model="ir.ui.view"> 
  <field name="name">Categoría Filter</field> 
  <field name="model">account.categoria</field> 
  <field name="arch" type="xml"> 
    <search> 
        <field name="name" />
        <field name="formato" />
        <field name="year" />
      <!--<filter string="No revisado" 
        domain="[('is_done','=',False)]"/> 
      <filter string="Revisado" 
        domain="[('is_done','!=',False)]"/> -->

    </search> 
  </field>   

</record> 


<record model='ir.actions.act_window' id='action_report_categoria'>
  <field name="name">Categoría</field>
  <field name="res_model">account.categoria</field>
  <field name="type">ir.actions.act_window</field>
  <field name="view_mode">list,form</field>

</record>

<menuitem id="report_categorias" name="Categorías" parent="account.account_account_menu" action="action_report_categoria" sequence="101"/> 


<record id="view_tree_conceptos" model="ir.ui.view"> 
    <field name="name">Reporte Conceptos</field> 
    <field name="model">account.concepto</field> 
    <field name="arch" type="xml"> 
      <!--<list colors="decoration-muted:is_done==True"> -->
      <list >
        <field name="name" />
        <field name="formato" />
        <field name="tipo_monto" />
        <field name="descripcion"/>
       <!-- <field name="is_done"/> -->
      </list> 
  </field> 
</record>


<record id="view_filter_conceptos" model="ir.ui.view"> 
  <field name="name">Conceptos Filter</field> 
  <field name="model">account.concepto</field> 
  <field name="arch" type="xml"> 
    <search> 
        <field name="name" />
        <field name="formato" />
        <field name="tipo_monto" />
        <field name="descripcion"/>
      <!--<filter string="No revisado" 
        domain="[('is_done','=',False)]"/> 
      <filter string="Revisado" 
        domain="[('is_done','!=',False)]"/> -->

    </search> 
  </field>   

</record> 



<record model='ir.actions.act_window' id='action_report_concepto'>
  <field name="name">Conceptos</field>
  <field name="res_model">account.concepto</field>
  <field name="type">ir.actions.act_window</field>
  <field name="view_mode">list,form</field>
</record>

<menuitem id="report_conceptos" name="Conceptos" parent="account.account_account_menu" action="medios_magneticos.action_report_concepto" sequence="102"/> 


<record id="view_tree_aso_conceptos" model="ir.ui.view">
    <field name="name">Reporte Asociación de Conceptos</field>
    <field name="model">account.asoconcepto</field> 
    <field name="arch" type="xml"> 
      <!--<list colors="decoration-muted:is_done==True"> -->
      <list >
        <field name="name" /> 
        <field name="year" /> 
        <field name="cuenta" />
        <field name="concepto" />
        <field name="formato" />
        <field name="formaton" />
        <field name="tipo_suma"/>
        <field name="categoria" string="Categorías" domain="[('year','=',year)]"/>
        <field name="fecha_expediccion" />
        <field name="ciudad" />
        <field name="tipo_de_fondo"/>
       <!-- <field name="is_done"/> -->
      </list> 
      
  </field> 
</record>
<record id="view_form_aso_conceptos" model="ir.ui.view"> 
    <field name="name">Formulario Asociación de Conceptos</field> 
    <field name="model">account.asoconcepto</field>
    <field name="arch" type="xml"> 
      <!--<list colors="decoration-muted:is_done==True"> -->
      <form>
        <group>
        <field name="name" /> 
        <field name="year" /> 
        <field name="concepto" />
        <field name="formato" />
        <field name="formaton" />
        <field name="cuenta" />
        
        
        <field name="tipo_suma" />
        <field name="categoria" string="Categoría" />
        <field name="ano_de_categoria" string="Año de Categoría" />
        <field name="fecha_expediccion" string="Fecha de expedición"/>
        <field name="ciudad" />
        <field name="tipo_de_fondo"/>
        </group>
       <!-- <field name="is_done"/> -->
      </form>       
      
  </field> 
</record>

<record id="view_filter_conceptos" model="ir.ui.view"> 
  <field name="name">Asociación de Conceptos Filtro</field> 
  <field name="model">account.asoconcepto</field> 
  <field name="arch" type="xml"> 
    <search>
        <field name="year" /> 
        <field name="cuenta" />
        <field name="concepto" />
        <field name="formato" />
        <field name="formaton" string="Formato Número"/>
        <field name="tipo_suma"/>
        <field name="categoria" string="Categorías"/>
        <field name="fecha_expediccion" string="Fecha de expedición"/>
        <field name="ciudad" />
        <field name="tipo_de_fondo"/>
      <!--<filter string="No revisado" 
        domain="[('is_done','=',False)]"/> 
      <filter string="Revisado" 
        domain="[('is_done','!=',False)]"/> -->

    </search> 
  </field>   

</record> 


<record model='ir.actions.act_window' id='action_asociacion_concepto'>
  <field name="name">Asociación de Conceptos</field>
  <field name="res_model">account.asoconcepto</field>
  <field name="type">ir.actions.act_window</field>
  <field name="view_mode">list,form</field>
</record>


<menuitem id="report_aso_conceptos" name="Asociación de Conceptos" parent="account.account_account_menu" action="action_asociacion_concepto" sequence="103"/> 

