<odoo>
    <data>
        <record id="view_account_exogena_config_tree" model="ir.ui.view">
            <field name="name">account.exogena_config.tree</field>
            <field name="model">account.exogena_config</field>
            <field name="arch" type="xml">
                <list string="Configuracion Exogena">
                    <field name="concepto_nombre"/>
                    <field name="categoria_nombre"/>
                    <field name="formato"/>
                    <field name="year"/>
                    <field name="cuenta"/>
                    <field name="tipo_suma"/>
                </list>
            </field>
        </record>

        <record id="view_account_exogena_config_form" model="ir.ui.view">
            <field name="name">account.exogena_config.form</field>
            <field name="model">account.exogena_config</field>
            <field name="arch" type="xml">
                <form string="Configuracion Exogena">
                    <sheet>
                        <group>
                            <group string="Concepto">
                                <field name="concepto_nombre"/>
                                <field name="concepto_descripcion"/>
                                <field name="tipo_monto"/>
                            </group>
                            <group string="Categoria">
                                <field name="categoria_nombre"/>
                                <field name="formato"/>
                                <field name="year"/>
                            </group>
                        </group>
                        <group>
                            <group string="Asociacion contable">
                                <field name="cuenta"/>
                                <field name="tipo_suma"/>
                            </group>
                            <group string="Datos adicionales">
                                <field name="ciudad"/>
                                <field name="fecha_expediccion"/>
                                <field name="tipo_de_fondo"/>
                                <field name="codigo_fondo"/>
                            </group>
                        </group>
                        <group>
                            <field name="nombre_completo" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_account_exogena_config_search" model="ir.ui.view">
            <field name="name">account.exogena_config.search</field>
            <field name="model">account.exogena_config</field>
            <field name="arch" type="xml">
                <search string="Buscar configuracion exogena">
                    <field name="concepto_nombre"/>
                    <field name="categoria_nombre"/>
                    <field name="formato"/>
                    <field name="year"/>
                    <field name="cuenta"/>
                    <filter string="Anio actual" name="current_year" domain="[('year', '=', context_today().strftime('%%Y'))]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Formato" name="group_formato" context="{'group_by': 'formato'}"/>
                        <filter string="Anio" name="group_year" context="{'group_by': 'year'}"/>
                        <filter string="Cuenta" name="group_cuenta" context="{'group_by': 'cuenta'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_account_exogena_config" model="ir.actions.act_window">
            <field name="name">Configuracion Exogena de Apoyo</field>
            <field name="res_model">account.exogena_config</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_account_exogena_config_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea y administra la configuracion unificada de exogena.
                </p>
                <p>
                    Aqui defines el concepto, la categoria, el formato y la cuenta contable
                    que luego usara la generacion de medios magneticos.
                </p>
            </field>
        </record>

        <menuitem id="menu_account_exogena_config_root"
                  name="Exogena"
                  parent="account.account_account_menu"
                  sequence="100"/>

    </data>
</odoo>
