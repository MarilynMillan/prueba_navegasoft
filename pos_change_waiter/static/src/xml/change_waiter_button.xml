<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Botón "Cambiar Mesero" dentro del diálogo de Actions -->
    <t t-name="pos_change_waiter.ChangeWaiterButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button class="btn btn-lg btn-outline-success py-5 change-waiter-btn"
                    t-if="isManager"
                    t-on-click="clickChangeWaiter">
                <i class="fa fa-exchange me-2"/>
                <span>Cambiar Mesero</span>
                <t t-if="currentWaiterName">
                    <small class="d-block text-muted mt-1">
                        Actual: <t t-esc="currentWaiterName"/>
                    </small>
                </t>
            </button>
        </xpath>
    </t>

</templates>
